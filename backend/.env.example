# 이 파일을 복사해서 .env로 만들고 실제 값 입력
# cp .env.example .env

# AWS
AWS_REGION=ap-northeast-2

# OpenSearch (도메인 생성 후 입력)
OPENSEARCH_ENDPOINT=search-mediger-xxxx.ap-northeast-2.es.amazonaws.com
OPENSEARCH_REGION=ap-northeast-2

# DynamoDB
PATIENTS_TABLE=Patients
DOCTOR_NOTES_TABLE=DoctorNotes
PRESCRIPTIONS_TABLE=Prescriptions

# Bedrock (서울 미지원 → us-east-1)
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-haiku-20240307-v1:0
BEDROCK_KB_ID=

# Kinesis Firehose
FIREHOSE_STREAM=diabetes-cgm-stream
